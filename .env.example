# Create an API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=replace-with-your-lastfm-api-key
LASTFM_USERNAME=replace-with-your-lastfm-username

# Create an API key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=replace-with-your-openweathermap-api-key

# Used only by the local development server.
PORT=3000
