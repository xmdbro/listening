# Create an API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=replace-with-your-lastfm-api-key
# Optional fallback for API and card requests that omit the user parameter.
LASTFM_USERNAME=
# Let visitors select a public Last.fm account in Listening preferences.
ALLOW_CUSTOM_LASTFM_USERS=true

# Create a Spotify app and select Web API. The app uses Client Credentials.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret

# Create an API key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=replace-with-your-openweathermap-api-key

# Used only by the local development server.
PORT=3000
